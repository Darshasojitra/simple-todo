<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task list</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%-include('nav') %>
    <h1>Task list page</h1>
    <div class="container">
        <form action="/multi-delete" method="post">
            <button class="delete-item" style="margin-bottom: 10px;">Delete Selected Task</button>
            <ul class="task-list">
                <% for(let task=0 ; task < result.length ; task++) { %>
                    <li class="task-item">
                        <div class="task-title">
                            <%= result[task].title %>
                        </div>
                        <div class="task-dec">
                            <%= result[task].description %>
                        </div>
                        <input type="checkbox" name="selectedTask" value="<%=result[task]._id %>" id="" >
                        <a href="/delete/<%= result[task]._id %>" class="del-btn">Delete</a>
                        <a href="/update/<%= result[task]._id %>" class="update-btn">Update</a>
                    </li>
                <% } %>
            </ul>
        </form>
    </div>
</body>
</html>